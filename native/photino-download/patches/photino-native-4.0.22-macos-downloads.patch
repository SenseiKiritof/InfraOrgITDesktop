 #ifdef __APPLE__
 #import "Photino.Mac.NavigationDelegate.h"
 
+#if defined(PHOTINO_MAC_DOWNLOADS) && PHOTINO_MAC_DOWNLOADS
+
+// Opt-in macOS download support for Photino.Native.
+//
+// Enable at compile time with -DPHOTINO_MAC_DOWNLOADS=1. Without the flag this
+// file behaves exactly like upstream v4.0.22.
+//
+// Scope: top-level navigations whose response is a download (Content-
+// Disposition: attachment, a MIME type WebKit cannot render, or a navigation
+// action that WebKit marks as a download, e.g. <a download>).
+//
+// Blob URLs have no HTTP response, so a direct blob: navigation never becomes a
+// WKDownload here. A blob URL used by an <a download> action can work (WebKit
+// synthesizes a response on newer macOS), but that path is OS/WebKit dependent
+// and is not the reliable case this patch targets. Content-Disposition
+// attachments are the reliable path; app-generated blobs need a JS/native
+// bridge.
+
+#if __MAC_OS_X_VERSION_MAX_ALLOWED >= 260000
+#define PHOTINO_RESPONSE_POLICY_DOWNLOAD WKNavigationResponsePolicyDownload
+#else
+// Same enum value (2) under the pre-Xcode-26 spelling.
+#define PHOTINO_RESPONSE_POLICY_DOWNLOAD ((WKNavigationResponsePolicy)2)
+#endif
+
+static void PhotinoDownloadLog(NSString *message)
+{
+    fprintf(stderr, "[photino-download] %s\n", [message UTF8String]);
+}
+
+static NSString *PhotinoDownloadHeader(NSURLResponse *response, NSString *name)
+{
+    if (![response isKindOfClass:[NSHTTPURLResponse class]])
+        return nil;
+
+    NSDictionary *headers = [(NSHTTPURLResponse *)response allHeaderFields];
+    for (NSString *key in headers)
+    {
+        if ([key caseInsensitiveCompare:name] == NSOrderedSame)
+            return [headers objectForKey:key];
+    }
+
+    return nil;
+}
+
+static BOOL PhotinoDownloadIsAttachment(NSURLResponse *response)
+{
+    NSString *disposition = PhotinoDownloadHeader(response, @"Content-Disposition");
+    if (disposition != nil)
+    {
+        NSString *value = [disposition lowercaseString];
+        NSRange semicolon = [value rangeOfString:@";"];
+        if (semicolon.location != NSNotFound)
+            value = [value substringToIndex:semicolon.location];
+        value = [value stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+        if ([value isEqualToString:@"attachment"])
+            return YES;
+    }
+
+    NSString *mimeType = [response MIMEType];
+    if (mimeType != nil && [mimeType caseInsensitiveCompare:@"application/octet-stream"] == NSOrderedSame)
+        return YES;
+
+    return NO;
+}
+
+static NSString *PhotinoDownloadSafeFilename(NSString *suggestedFilename)
+{
+    NSString *name = [suggestedFilename lastPathComponent];
+    if (name.length == 0 || [name isEqualToString:@"."] || [name isEqualToString:@".."] || [name isEqualToString:@"/"])
+        name = @"download";
+    return name;
+}
+
+static NSURL *PhotinoDownloadUniqueURL(NSURL *directory, NSString *filename)
+{
+    NSFileManager *fileManager = [NSFileManager defaultManager];
+    NSURL *candidate = [directory URLByAppendingPathComponent:filename];
+    NSString *base = [filename stringByDeletingPathExtension];
+    NSString *extension = [filename pathExtension];
+
+    for (NSUInteger index = 1; [fileManager fileExistsAtPath:[candidate path]]; index++)
+    {
+        NSString *suffix = [NSString stringWithFormat:@" (%lu)", (unsigned long)index];
+        NSString *name = extension.length > 0
+            ? [NSString stringWithFormat:@"%@%@.%@", base, suffix, extension]
+            : [NSString stringWithFormat:@"%@%@", base, suffix];
+        candidate = [directory URLByAppendingPathComponent:name];
+    }
+
+    return candidate;
+}
+
+@interface PhotinoDownloadDelegate : NSObject <WKDownloadDelegate>
+{
+    @public
+    NavigationDelegate *owner;
+}
+@end
+
+@interface NavigationDelegate ()
+- (void)removeActiveDownload:(PhotinoDownloadDelegate *)download;
+- (void)attachDownload:(WKDownload *)download;
+@end
+
+@implementation PhotinoDownloadDelegate
+
+- (void)detach
+{
+    // Removing the last reference from activeDownloads releases this object.
+    // Keep it alive until the fields below have been cleared.
+    [self retain];
+    if (owner != nil)
+        [owner removeActiveDownload:self];
+    owner = nil;
+    [self release];
+}
+
+- (void)download:(WKDownload *)download
+        decideDestinationUsingResponse:(NSURLResponse *)response
+        suggestedFilename:(NSString *)suggestedFilename
+        completionHandler:(void (^)(NSURL *destination))completionHandler
+{
+    NSString *filename = PhotinoDownloadSafeFilename(suggestedFilename);
+    NSDictionary *environment = [[NSProcessInfo processInfo] environment];
+    NSString *downloadDirectory = [environment objectForKey:@"PHOTINO_DOWNLOAD_DIR"];
+
+    // PHOTINO_DOWNLOAD_DIR is intentionally an environment override: it lets
+    // unattended/smoke runs save without opening a panel, and lets a host opt
+    // into a fixed download folder. Normal desktop use goes through NSSavePanel.
+    if (downloadDirectory.length > 0)
+    {
+        NSString *path = [downloadDirectory stringByExpandingTildeInPath];
+        NSFileManager *fileManager = [NSFileManager defaultManager];
+        NSError *error = nil;
+        BOOL isDirectory = NO;
+
+        if (![fileManager fileExistsAtPath:path isDirectory:&isDirectory])
+        {
+            [fileManager createDirectoryAtPath:path withIntermediateDirectories:YES attributes:nil error:&error];
+            isDirectory = (error == nil);
+        }
+
+        if (!isDirectory || ![fileManager isWritableFileAtPath:path])
+        {
+            PhotinoDownloadLog([NSString stringWithFormat:@"destination directory is not writable: %@", path]);
+            completionHandler(nil);
+            [self detach];
+            return;
+        }
+
+        NSURL *destination = PhotinoDownloadUniqueURL([NSURL fileURLWithPath:path], filename);
+        PhotinoDownloadLog([NSString stringWithFormat:@"saving %@", [destination lastPathComponent]]);
+        completionHandler(destination);
+        return;
+    }
+
+    // WebKit requires the completion handler to be callable asynchronously.
+    // The panel is therefore presented outside the delegate callback.
+    dispatch_async(dispatch_get_main_queue(), ^{
+        NSSavePanel *panel = [[NSSavePanel savePanel] retain];
+        [panel setNameFieldStringValue:filename];
+        [panel setCanCreateDirectories:YES];
+        [panel setExtensionHidden:NO];
+
+        NSArray *downloads = NSSearchPathForDirectoriesInDomains(NSDownloadsDirectory, NSUserDomainMask, YES);
+        NSString *directory = downloads.count > 0 ? [downloads objectAtIndex:0] : NSHomeDirectory();
+        [panel setDirectoryURL:[NSURL fileURLWithPath:directory]];
+
+        [NSApp activateIgnoringOtherApps:YES];
+        NSModalResponse modalResponse = [panel runModal];
+        if (modalResponse == NSModalResponseOK)
+        {
+            NSURL *destination = [panel URL];
+            NSFileManager *fileManager = [NSFileManager defaultManager];
+            NSError *error = nil;
+
+            // The panel already confirmed overwrite; WKDownload needs a path
+            // that does not exist yet.
+            if ([fileManager fileExistsAtPath:[destination path]])
+            {
+                if (![fileManager removeItemAtURL:destination error:&error])
+                {
+                    PhotinoDownloadLog([NSString stringWithFormat:@"cannot replace %@: %@", [destination path], [error localizedDescription]]);
+                    completionHandler(nil);
+                    [self detach];
+                    [panel release];
+                    return;
+                }
+            }
+
+            PhotinoDownloadLog([NSString stringWithFormat:@"saving %@", [destination lastPathComponent]]);
+            completionHandler(destination);
+        }
+        else
+        {
+            PhotinoDownloadLog([NSString stringWithFormat:@"download cancelled: %@", filename]);
+            completionHandler(nil);
+            [self detach];
+        }
+
+        [panel release];
+    });
+}
+
+- (void)downloadDidFinish:(WKDownload *)download
+{
+    // Do not log originalRequest.URL: signed desktop download tickets can be
+    // embedded in the path.
+    PhotinoDownloadLog(@"finished download");
+    [self detach];
+}
+
+- (void)download:(WKDownload *)download
+        didFailWithError:(NSError *)error
+        resumeData:(NSData *)resumeData
+{
+    PhotinoDownloadLog([NSString stringWithFormat:@"download failed: %@", [error localizedDescription]]);
+    [self detach];
+}
+
+@end
+
+#endif // PHOTINO_MAC_DOWNLOADS
+
 @implementation NavigationDelegate : NSObject
 
+#if defined(PHOTINO_MAC_DOWNLOADS) && PHOTINO_MAC_DOWNLOADS
+
+- (instancetype)init
+{
+    self = [super init];
+    if (self != nil)
+        activeDownloads = [[NSMutableSet alloc] init];
+    return self;
+}
+
+- (void)dealloc
+{
+    // A pending NSSavePanel block can keep a delegate alive after this
+    // NavigationDelegate is gone. Clear the back-pointer so detach is a no-op.
+    for (PhotinoDownloadDelegate *download in activeDownloads)
+        download->owner = nil;
+    [activeDownloads release];
+    [super dealloc];
+}
+
+- (void)removeActiveDownload:(PhotinoDownloadDelegate *)download
+{
+    [activeDownloads removeObject:download];
+}
+
+- (void)attachDownload:(WKDownload *)download
+{
+    PhotinoDownloadDelegate *delegate = [[[PhotinoDownloadDelegate alloc] init] autorelease];
+    delegate->owner = self;
+    [activeDownloads addObject:delegate];
+    download.delegate = delegate;
+}
+
+- (void)webView:(WKWebView *)webView
+        decidePolicyForNavigationAction:(WKNavigationAction *)navigationAction
+        decisionHandler:(void (^)(WKNavigationActionPolicy))decisionHandler
+{
+    if (@available(macOS 11.3, *))
+    {
+        if (navigationAction.shouldPerformDownload)
+        {
+            // No URL in the log: it may be a signed ticket URL.
+            PhotinoDownloadLog(@"navigation action requests download");
+            decisionHandler(WKNavigationActionPolicyDownload);
+            return;
+        }
+    }
+
+    decisionHandler(WKNavigationActionPolicyAllow);
+}
+
+- (void)webView:(WKWebView *)webView
+        decidePolicyForNavigationResponse:(WKNavigationResponse *)navigationResponse
+        decisionHandler:(void (^)(WKNavigationResponsePolicy))decisionHandler
+{
+    if (@available(macOS 11.3, *))
+    {
+        NSURLResponse *response = [navigationResponse response];
+        BOOL attachment = PhotinoDownloadIsAttachment(response);
+        BOOL renderable = [navigationResponse canShowMIMEType];
+
+        if ([navigationResponse isForMainFrame] && (attachment || !renderable))
+        {
+            // No URL in the log: it may be a signed ticket URL.
+            PhotinoDownloadLog([NSString stringWithFormat:@"%@ navigation response becomes download (%@)",
+                attachment ? @"attachment" : @"non-renderable",
+                [[response suggestedFilename] length] > 0 ? [response suggestedFilename] : @"unnamed"]);
+            decisionHandler(PHOTINO_RESPONSE_POLICY_DOWNLOAD);
+            return;
+        }
+    }
+
+    decisionHandler(WKNavigationResponsePolicyAllow);
+}
+
+- (void)webView:(WKWebView *)webView
+        navigationAction:(WKNavigationAction *)navigationAction
+        didBecomeDownload:(WKDownload *)download
+{
+    if (@available(macOS 11.3, *))
+        [self attachDownload:download];
+}
+
+- (void)webView:(WKWebView *)webView
+        navigationResponse:(WKNavigationResponse *)navigationResponse
+        didBecomeDownload:(WKDownload *)download
+{
+    if (@available(macOS 11.3, *))
+        [self attachDownload:download];
+}
+
+#endif // PHOTINO_MAC_DOWNLOADS
