{
  "name": "infraorgit-desktop",
  "productName": "InfraOrgIT",
  "version": "0.3.1",
  "private": true,
  "description": "Electron desktop shell for InfraOrgIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:shell",
    "test:unit": "node --test test/unit/*.test.js",
    "test:shell": "node test/run-shell-test.js",
    "tunnel-test": "node test/tunnel-test.js",
    "package": "node scripts/package.js",
    "package:mac": "node scripts/package.js --platform=darwin --arch=arm64",
    "package:win": "node scripts/package.js --platform=win32 --arch=x64",
    "package:linux": "node scripts/package.js --platform=linux --arch=x64"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1"
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
