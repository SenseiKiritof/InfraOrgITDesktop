{
  "name": "infraorgit-desktop",
  "productName": "InfraOrgIT",
  "version": "0.2.0",
  "private": true,
  "description": "Electron desktop shell for InfraOrgIT",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "npm run test:unit && npm run test:shell",
    "test:unit": "node --test test/unit/*.test.js",
    "test:shell": "node test/run-shell-test.js",
    "tunnel-test": "node test/tunnel-test.js",
    "package": "electron-packager . InfraOrgIT --out=dist --asar --overwrite --app-bundle-id=it.infraorgit.desktop --ignore=\"^/test($|/)\" --ignore=\"^/node_modules($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/package-lock\\.json$\"",
    "package:mac": "electron-packager . InfraOrgIT --platform=darwin --arch=arm64 --out=dist --asar --overwrite --app-bundle-id=it.infraorgit.desktop --ignore=\"^/test($|/)\" --ignore=\"^/node_modules($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/package-lock\\.json$\"",
    "package:win": "electron-packager . InfraOrgIT --platform=win32 --arch=x64 --out=dist --asar --overwrite --app-bundle-id=it.infraorgit.desktop --ignore=\"^/test($|/)\" --ignore=\"^/node_modules($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/package-lock\\.json$\"",
    "package:linux": "electron-packager . InfraOrgIT --platform=linux --arch=x64 --out=dist --asar --overwrite --app-bundle-id=it.infraorgit.desktop --ignore=\"^/test($|/)\" --ignore=\"^/node_modules($|/)\" --ignore=\"^/README\\.md$\" --ignore=\"^/package-lock\\.json$\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.3.1"
  }
}
